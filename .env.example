# Notion integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxx
# Comma-separated root page/database ids to sync (empty = everything shared with the integration)
NOTION_ROOT_IDS=

# LLM provider: claude_cli (subscription, personal use only) | anthropic_api
LLM_PROVIDER=claude_cli
LLM_MODEL=sonnet
# Only needed when LLM_PROVIDER=anthropic_api
ANTHROPIC_API_KEY=

# Vector DB: empty QDRANT_URL = embedded local mode at QDRANT_PATH
QDRANT_URL=
QDRANT_PATH=./data/qdrant
